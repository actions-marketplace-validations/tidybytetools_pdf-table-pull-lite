{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.tidybytetools/pdf-table-pull-lite",
  "title": "pdf-table-pull-lite",
  "description": "Pull tables out of local text PDFs as CSV. Runs on your computer, nothing uploaded.",
  "repository": {
    "url": "https://github.com/tidybytetools/pdf-table-pull-lite",
    "source": "github"
  },
  "websiteUrl": "https://tidybytetools.github.io/tools/pdf-table-pull/",
  "version": "1.3.1",
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "pdf-table-pull-lite",
      "version": "1.3.1",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp",
          "description": "Starts the MCP server instead of the command-line tool."
        }
      ]
    }
  ]
}
